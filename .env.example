# Application Secrets
API_KEY=sk-your-api-key-here
DB_PASSWORD=your-db-password-here
ADMIN_PASSWORD=your-admin-password-here
SECRET_TOKEN=your-secret-token-here
SMTP_USER=your-smtp-user-here
SMTP_PASSWORD=your-smtp-password-here
SMTP_API_KEY=your-smtp-api-key-here
AWS_SECRET=your-aws-secret-here
ENCRYPTION_KEY=your-encryption-key-here
LOG_API_KEY=your-log-api-key-here
LOG_ENDPOINT=https://api.logging.com/v1/logs
UPLOAD_DIR=/var/www/uploads

# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=my-app
GITHUB_BASE_BRANCH=main

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Security Workflow Configuration
PATTERN_DETECTOR_INTERVAL=30
DASHBOARD_PORT=3000
ENABLE_AUTO_FIX=true
ENABLE_SLACK_NOTIFICATIONS=true

# Claude API (for manual fix skill)
CLAUDE_API_KEY=sk-ant-your-api-key-here

# Security Thresholds
SECURITY_ISSUE_SEVERITY_THRESHOLD=high
AUTO_MERGE_LOW_RISK_FIXES=false

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
